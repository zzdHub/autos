{
  "log": {
    "disabled": false,
    "level": "error"
  },
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "Local-DNS",
        "server": "114.114.114.114"
      },
      {
        "tag": "Remote-DNS",
        "type": "tls",
        "server": "dns.google",
        "domain_resolver": "Local-DNS",
        "detour": "select"
      }
    ],
    "rules": [
      {
        "rule_set": "GeoSite-CN",
        "server": "Local-DNS"
      },
      {
        "domain_suffix": [
          "google.com",
          "youtube.com",
          "googleapis.com",
          "twitter.com",
          "x.com"
        ],
        "server": "Remote-DNS"
      }
    ],
    "final": "Remote-DNS",
    "independent_cache": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "mtu": 1420,
      "address": "172.18.0.1/30",
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed"
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "select",
      "outbounds": [
        "direct"
      ],
      "interrupt_exist_connections": true
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "protocol": "quic",
        "action": "reject"
      },
      {
        "rule_set": "Category-Ads",
        "action": "reject"
      },
      {
        "package_name": "com.android.vending",
        "outbound": "select"
      },
      {
        "rule_set": "geosite-youtube",
        "outbound": "select"
      },
      {
        "rule_set": "geosite-google",
        "outbound": "select"
      },
      {
        "rule_set": "category-ads-all",
        "action": "reject"
      },
      {
        "rule_set": "GeoLocation-!CN",
        "outbound": "select"
      },
      {
        "rule_set": "GeoSite-Private",
        "outbound": "direct"
      },
      {
        "rule_set": "GeoSite-CN",
        "outbound": "direct"
      },
      {
        "rule_set": "GeoIP-CN",
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "Category-Ads",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ads-all.srs",
        "download_detour": "direct"
      },
      {
        "type": "remote",
        "tag": "GeoIP-Private",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/private.srs",
        "download_detour": "direct"
      },
      {
        "type": "remote",
        "tag": "GeoSite-Private",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.srs",
        "download_detour": "direct"
      },
      {
        "type": "remote",
        "tag": "GeoIP-CN",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "download_detour": "direct"
      },
      {
        "type": "remote",
        "tag": "GeoSite-CN",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs",
        "download_detour": "direct"
      },
      {
        "type": "remote",
        "tag": "GeoLocation-!CN",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs",
        "download_detour": "direct"
      },
      {
        "type": "remote",
        "tag": "geosite-google",
        "url": "https://fastly.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-google.srs",
        "download_detour": "direct"
      },
      {
        "type": "remote",
        "tag": "geosite-youtube",
        "url": "https://fastly.jsdelivr.net/gh/Yuu518/sing-box-rules@rule_set/rule_set_site/youtube.srs",
        "download_detour": "direct"
      },
      {
        "type": "remote",
        "tag": "category-ads-all",
        "url": "https://fastly.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-category-ads-all.srs",
        "download_detour": "direct"
      }
    ],
    "final": "select",
    "auto_detect_interface": true,
    "default_domain_resolver": "Local-DNS"
  }
}
